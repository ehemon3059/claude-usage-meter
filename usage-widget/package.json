{
  "name": "usage-widget",
  "version": "1.0.0",
  "description": "Claude usage meter for Windows",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test \"tests/*.test.js\"",
    "build": "electron-builder",
    "dev:gauges": "node scripts/start.js scripts/dev-gauges.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.emon.usagewidget",
    "productName": "Usage Widget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "scraper.js",
      "parser.js",
      "state.js",
      "alerts.js",
      "preload.js",
      "widget.html",
      "widget.css",
      "gauges.js",
      "clock.js",
      "timesync.js",
      "widget.js",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "UsageWidget-Setup.exe"
    }
  }
}
